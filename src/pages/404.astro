---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found." ogSlug="index">
  <main class="mx-auto max-w-3xl px-6 pt-24 pb-16 min-h-[60vh] flex flex-col justify-center">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent)]">404</p>
    <h1 class="mt-6 text-4xl sm:text-5xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-5 text-[var(--color-muted)] max-w-prose">
      The page you're looking for doesn't exist or has moved.
    </p>
    <p class="mt-8 font-mono text-xs uppercase tracking-wider">
      <a href="/">← Back home</a>
    </p>
  </main>
</BaseLayout>
