---
import type { CollectionEntry } from 'astro:content';
import StackBadges from './StackBadges.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, oneLiner, status, year, stack, aiTools } = project.data;
const isWip = status === 'wip';
const href = `/projects/${project.id}`;

const statusLabel: Record<typeof status, string> = {
  live: 'Live',
  archived: 'Archived',
  wip: 'WIP',
};
---

<article
  class:list={[
    'group relative border-t border-[var(--color-rule)] py-8',
    featured && 'sm:grid sm:grid-cols-[2fr_3fr] sm:gap-10',
    isWip && 'opacity-70',
  ]}
>
  <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wider text-[var(--color-muted)]">
    <span>{year}</span>
    <span aria-hidden="true">·</span>
    <span
      class:list={[
        'px-1.5 py-0.5 rounded-sm border',
        status === 'live'
          ? 'border-[var(--color-accent)] text-[var(--color-accent)]'
          : 'border-[var(--color-rule)]',
      ]}
    >
      {statusLabel[status]}
    </span>
  </div>

  <div class={featured ? '' : 'mt-3'}>
    <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight leading-tight">
      <a
        href={href}
        class="!text-[var(--color-fg)] hover:!text-[var(--color-accent)] no-underline"
      >
        <span class="absolute inset-0" aria-hidden="true" />
        {title}
      </a>
    </h2>
    <p class="mt-3 text-[var(--color-muted)] leading-relaxed max-w-prose">
      {oneLiner}
    </p>

    {
      (stack.length > 0 || aiTools.length > 0) && (
        <div class="mt-5 flex flex-col gap-2">
          {aiTools.length > 0 && <StackBadges items={aiTools} variant="ai" />}
          {stack.length > 0 && <StackBadges items={stack} variant="stack" />}
        </div>
      )
    }
  </div>
</article>
